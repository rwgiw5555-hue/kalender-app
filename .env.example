# Kopieren nach .env und ausfüllen. .env niemals committen.
ANTHROPIC_API_KEY=
DATABASE_URL=file:./dev.db
# Weitere erlaubte Hostnamen, z. B. der Tailscale-Name des Servers (kommagetrennt)
ALLOWED_HOSTS=
# Geheimer Schlüssel für den Siri-Kurzbefehl (mind. 32 Zeichen, z. B. openssl rand -hex 32). Leer = aus.
SHORTCUT_TOKEN=
